.dialogue-root {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
}

.line-panel {
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 8px;
}

.speaker-name {
    -unity-font-style: bold;
    font-size: 16px;
    color: rgb(255, 220, 130);
    margin-bottom: 4px;
}

.line-text {
    font-size: 18px;
    color: rgb(240, 240, 240);
    white-space: normal;
}

.choices-container {
    flex-direction: column;
}

.dialogue-choice {
    font-size: 16px;
    margin: 2px 0;
    padding: 8px 12px;
}

.dialogue-choice.disabled {
    opacity: 0.45;
}
